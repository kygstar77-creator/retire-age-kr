0683, 11156, 11333, 11376, 11317, 11501, 11706, 11822, 11847, 11730, 11270, 11064, 11086, 10844, 10698, 10630, 10927, 11051, 10711, 10726, 10439, 10402]]], "n": 126, "min": 9000, "max": 15000, "draw": 0, "xlabels": [[0, "10월"], [20, "12월"], [41, "2월"], [62, "4월"], [82, "6월"], [104, "8월"], [125, "10월"]], "tags": [["SPY", 93.5, 12304, "7.2 · 123,037,245원", 355, "up", false], ["SPY", 117.5, 10776, "9.10 · 107,755,946원", 369, "left", false], ["GLD", 40.0, 14364, "1.28 · 143,638,454원", 527, "up", true], ["GLD", 123.5, 10243, "9.28 · 102,425,567원 (−28.69%)", 543, "down", true]], "fxAt": 167, "fx": ["환율 최고 1,554.4원", "최저 1,337.9원"]}, "lines": [{"text": "그런데 시작과 끝만 보면 놓치는 게 있어요. 1년 안에서는 환율이 훨씬 크게 움직였거든요.", "cap": null, "frames": 167, "audio": "audio/r-1/d6ade2cade6a070d.wav"}, {"text": "가장 높았던 날은 1,554.4원이었고요.", "cap": null, "frames": 93, "audio": "audio/r-1/db13ec5201bf9a48.wav"}, {"text": "가장 낮았던 날은 1,337.9원이었어요.", "cap": "원/달러 매매기준율 1년 안 최고 1,554.4원(2026.7.2) · 최저 1,337.9원(2026.9.10)", "frames": 95, "audio": "audio/r-1/7af261ace461701f.wav"}, {"text": "그래서 S&P500에 넣은 1억은, 석 달 만에 1,528만원이 환율 때문에 빠진 구간이 있었어요.", "cap": "SPY 1억 원화 평가액 2026.7.2 123,037,245원 → 2026.9.10 107,755,946원 · 그사이 달러 가격은 +1.75%", "frames": 172, "audio": "audio/r-1/1efb57568a11ebb7.wav"}, {"text": "금은 더 컸어요. 가장 높았던 날부터 30% 가까이 내려왔거든요.", "cap": "금(GLD) 1억 원화 평가액 2026.1.28 143,638,454원 → 2026.9.28 102,425,567원 (−28.69%)", "frames": 136, "audio": "audio/r-1/72b1cad5f4abb492.wav"}, {"text": "그러니까 1년 영수증은 끝날 하루의 사진이고, 그 사이 길은 훨씬 거칠었습니다.", "cap": null, "frames": 142, "audio": "audio/r-1/bfca2728854fd686.wav"}], "frames": 805}, {"key": "spy", "kind": "receipt", "title": "S&P500 영수증", "sub": "SPY · 달러로 사서 1년 뒤 원화로 판 값", "source": "거래소 종가·분배금(야후 파이낸스·나스닥, SCHD 분배금은 찰스슈왑 원문) · 원/달러 ECOS 731Y001", "chapter": "3장", "data": {"head": "S&P500 ETF(SPY) · 1억 · 단위 원", "side": ["+15.01%", 117, "달러로 1년 동안 오른 폭"], "rows": [["달러로 오른 폭", "+15.01%", "in", 107], ["원화로 판 돈", "111,210,188", "in", 214], ["그중 이익", "11,210,188", "hi", 232], ["분배금 4번(세금 전)", "+1,095,716", "in", 538], ["그중 네 번째(10.30 입금)", "272,929", "dim", 678]], "callout": ["판 날보다 4주 늦게 들어오는 분배금", 688]}, "lines": [{"text": "세 번째는 미국 대표 지수인 S&P500이에요.", "cap": null, "frames": 107, "audio": "audio/r-1/67bde79ddf84317d.wav"}, {"text": "달러로 보면 1년 동안 약 15% 올랐습니다.", "cap": "SPY 종가 669.22 → 769.64달러 (+15.01%)", "frames": 107, "audio": "audio/r-1/0a487fb2cc6def30.wav"}, {"text": "환율까지 반영해서 팔면, 남는 이익은 1,121만원이에요.", "cap": "판 돈 111,210,188원 · 이익 11,210,188원", "frames": 148, "audio": "audio/r-1/a7cec3009173c333.wav"}, {"text": "여기에 분배금이 더 있어요. ETF 안의 회사들이 준 배당을 모아서 나눠 주는 돈이에요.", "cap": null, "frames": 176, "audio": "audio/r-1/b9da7b2a3b3ac353.wav"}, {"text": "석 달에 한 번씩 네 번, 원화로 다 합치면 약 110만원이에요.", "cap": "분배금(세금 전) 1,095,716원 · 4번", "frames": 140, "audio": "audio/r-1/4410b81ce1026da9.wav"}, {"text": "재밌는 건 마지막 분배금이에요. 판 날보다 4주 늦게 들어와요.", "cap": "네 번째 분배금 기준일 2026.9.18 · 지급일 2026.10.30 · 1억 기준 세금 전 272,929원", "frames": 149, "audio": "audio/r-1/8fb7060bfb7f9ae4.wav"}, {"text": "기준일에 들고만 있었으면 팔고 나서도 받는다는 뜻이라, 판 날 통장만 보면 이 돈이 안 보여요.", "cap": null, "frames": 191, "audio": "audio/r-1/99090987655e6f67.wav"}], "frames": 1018}, {"key": "spytax", "kind": "receipt", "title": "세금은 두 군데서 뗀다", "sub": "분배금은 미국에서 15% · 판 이익은 250만원 넘는 부분에 22%", "source": "소득세법 제94·103·104·110조 · 지방세법 제103조의3 · 한미 조세조약 제12조(IRS Table 1)", "chapter": "3장", "data": {"head": "SPY 세금 계산 · 단위 원", "side": ["22%", 933, "공제 250만원 넘는 이익에 붙는 세율"], "rows": [["분배금에서 (미국 15%)", "−164,357", "tax", 614], ["판 이익", "11,210,188", "in", 723], ["빼 주는 돈(공제)", "−2,500,000", "dim", 737], ["곱하는 세율", "× 22%", "in", 923], ["판 이익 세금", "−1,916,240", "tax", 1029]], "callout": ["넣은 돈이 작을수록 세금 비중 ↓", 1169]}, "lines": [{"text": "자, 이제 세금이에요. 뒤에 나오는 두 장도 똑같이 계산하니까, 여기서 한 번만 짚을게요.", "cap": null, "frames": 176, "audio": "audio/r-1/13c8866538bfa4c0.wav"}, {"text": "세금은 두 군데서 떼요. 분배금에서 한 번, 판 이익에서 한 번이요.", "cap": null, "frames": 152, "audio": "audio/r-1/6f29a75292a924c1.wav"}, {"text": "먼저 분배금은 미국에서 15%를 떼고 들어와요.", "cap": null, "frames": 112, "audio": "audio/r-1/69a8440087304d79.wav"}, {"text": "한국과 미국의 조세조약 때문에 그렇고, 그만큼 냈으면 국내에서 또 떼지는 않아요.", "cap": null, "frames": 174, "audio": "audio/r-1/b05a94d969efd8c9.wav"}, {"text": "그래서 분배금에서 약 16만원이 빠졌어요.", "cap": "분배금에서 미국이 뗀 세금 15% −164,357원", "frames": 109, "audio": "audio/r-1/6dab5713299adf93.wav"}, {"text": "다음은 판 이익이에요. 해외 ETF를 팔아 남긴 돈은 해마다 250만원까지는 세금을 안 매겨요.", "cap": null, "frames": 200, "audio": "audio/r-1/c42022a59f77bce8.wav"}, {"text": "그걸 넘는 부분에만 22%를 매기고요.", "cap": "판 이익 세금 = (이익 − 250만원) × 22% · 소득세 20% + 지방소득세 2% · 다른 해외 주식 이익이 없다고 가정", "frames": 106, "audio": "audio/r-1/de92d8e3ba413b5e.wav"}, {"text": "그래서 SPY는 판 이익 세금이 약 192만원이에요.", "cap": "(11,210,188 − 2,500,000) × 22% = 1,916,240원", "frames": 140, "audio": "audio/r-1/f77887ebb0fe741b.wav"}, {"text": "공제가 금액과 상관없이 똑같다 보니, 넣은 돈이 작을수록 세금 비중이 확 줄어든다는 뜻이기도 해요.", "cap": null, "frames": 196, "audio": "audio/r-1/2f51c98d44597f35.wav"}], "frames": 1365}, {"key": "spycal", "kind": "zoom", "title": "판 이익 세금은 나중에 낸다", "sub": "팔 때 바로 빠지지 않는다 — 다음 해 5월 직접 신고", "source": "소득세법 제94·103·104·110조 · 지방세법 제103조의3 · 한미 조세조약 제12조(IRS Table 1)", "chapter": "3장", "data": {"text": "다음 해 5월", "label": "판 이익 세금 내는 때", "note": "확정신고 5월 1일~31일", "start": 8, "after": ["세금 두 가지 다 낸 뒤", "110,225,307원", "+10.23%", 419]}, "lines": [{"text": "그런데 이 세금은 좀 특이해요. 팔 때 바로 빠지지 않거든요.", "cap": null, "frames": 126, "audio": "audio/r-1/96737e42ec5e44c2.wav"}, {"text": "다음 해 5월에 내가 직접 신고하고 내야 합니다.", "cap": "양도소득세 확정신고 · 다음 해 5월 1일~31일 (소득세법 제110조)", "frames": 112, "audio": "audio/r-1/c4d5e1c3d01956fd.wav"}, {"text": "그러니까 팔고 나서 통장에 찍힌 돈이 전부 내 돈은 아니에요. 다 써 버리면 신고할 때 당황하게 되죠.", "cap": null, "frames": 181, "audio": "audio/r-1/7cf12185554716a1.wav"}, {"text": "이렇게 세금 두 가지를 다 내면, 원금보다 10% 조금 넘게 늘어 있어요.", "cap": "세금 뒤 110,225,307원 (+10.23%) · 운용 보수는 매일 가격에 이미 반영", "frames": 195, "audio": "audio/r-1/a05728c6a553f4ee.wav"}], "frames": 614}, {"key": "schd", "kind": "receipt", "title": "SCHD 영수증", "sub": "배당 ETF · 계산 방법은 S&P500과 같다", "source": "거래소 종가·분배금(야후 파이낸스·나스닥, SCHD 분배금은 찰스슈왑 원문) · 원/달러 ECOS 731Y001", "chapter": "4장", "data": {"head": "SCHD · 1억 · 단위 원", "side": ["+15.99%", 819, "세금 뗀 뒤, 넣은 돈보다 늘어난 비율"], "rows": [["달러로 오른 폭", "+19.68%", "in", 157], ["원화로 판 돈", "115,728,578", "in", 187], ["분배금 4번(세금 전)", "+3,728,285", "in", 254], ["미국이 뗀 세금 15%", "−559,242", "tax", 574], ["판 이익 세금", "−2,910,286", "tax", 693], ["세금 다 낸 뒤", "115,987,335", "net", 809]], "callout": ["1주당 분배금 1.0339 → 1.0541달러 (+1.95%)", 443]}, "lines": [{"text": "네 번째는 배당 ETF로 많이 알려진 SCHD예요. 계산은 방금 한 그대로예요.", "cap": null, "frames": 157, "audio": "audio/r-1/cc9c1def3fbb5871.wav"}, {"text": "SCHD는 달러로 약 20% 올랐어요.", "cap": "SCHD 종가 27.34 → 32.72달러 (+19.68%)", "frames": 97, "audio": "audio/r-1/76d340b8eb17039a.wav"}, {"text": "배당 ETF답게 분배금도 컸어요. 네 번을 합치면 약 373만원이에요.", "cap": "분배금(세금 전) 3,728,285원 · 4번", "frames": 189, "audio": "audio/r-1/dc2cf23e5e844015.wav"}, {"text": "1주당 분배금도 그 전 1년보다 2% 가까이 늘었어요.", "cap": "1주당 분배금 4번 합 1.0339달러 → 1.0541달러 (+1.95%) · 슈왑 운용사 분배금 표", "frames": 131, "audio": "audio/r-1/aec1ef4b7842b1c4.wav"}, {"text": "여기서 미국 세금으로 약 56만원이 빠지고요.", "cap": "미국이 뗀 세금 15% −559,242원", "frames": 119, "audio": "audio/r-1/2ed4205f205e3e6b.wav"}, {"text": "판 이익에는 291만원 정도 세금이 붙어요.", "cap": "이익 15,728,578원 → 판 이익 세금 2,910,286원", "frames": 116, "audio": "audio/r-1/c4cc298126a84e49.wav"}, {"text": "다 내고 나면 원금보다 16% 가까이 늘었어요. 네 장 가운데 가장 많이 남은 영수증이에요.", "cap": "세금 뒤 115,987,335원 (+15.99%)", "frames": 201, "audio": "audio/r-1/ab5e3c1d75f0fed4.wav"}], "frames": 1010}, {"key": "gold", "kind": "bars", "title": "금은 환율이 주인공", "sub": "GLD · 같은 1년을 두 가지로 잰 늘어난 비율", "source": "거래소 종가·분배금(야후 파이낸스·나스닥, SCHD 분배금은 찰스슈왑 원문) · 원/달러 ECOS 731Y001", "chapter": "5장", "data": {"dir": "v", "max": 8, "tags": true, "bars": [["달러로 잰 오른 폭", 7.15, "+7.15%", 0, "ink"], ["원화로, 세금 뗀 뒤", 3.37, "+3.37%", 587, "accent"]], "note": ["환율 −3.30%가 깎아 먹음", 142], "circle": [1, 607]}, "lines": [{"text": "마지막 영수증은 금이에요. 금값은 달러로 약 7% 올랐어요.", "cap": "GLD 종가 354.79 → 380.14달러 (+7.15%)", "frames": 142, "audio": "audio/r-1/5e6cfebc2921f07c.wav"}, {"text": "그런데 원화로 바꾸고 나면 이익이 361만원으로 줄어요.", "cap": "판 돈 103,609,129원 · 이익 3,609,129원", "frames": 140, "audio": "audio/r-1/73794766a7790426.wav"}, {"text": "이 기간에 분배금은 없었고, 이익이 공제 250만원을 조금 넘는 정도라서 세금도 적어요.", "cap": null, "frames": 207, "audio": "audio/r-1/d1267a8d09110485.wav"}, {"text": "판 이익 세금은 약 24만원이에요.", "cap": "(3,609,129 − 2,500,000) × 22% = 244,007원", "frames": 98, "audio": "audio/r-1/a4a656a5ecb88153.wav"}, {"text": "다 내고 나면 3% 조금 넘게 늘었어요.", "cap": "세금 뒤 103,365,122원 (+3.37%)", "frames": 111, "audio": "audio/r-1/523c3d783a7621fc.wav"}, {"text": "앞에서 본 것처럼 중간에는 크게 올랐다 내려왔는데, 끝날 하루만 보면 예금과 별 차이가 없어 보이는 거죠.", "cap": null, "frames": 210, "audio": "audio/r-1/094f750e180ad994.wav"}], "frames": 908}, {"key": "rank", "kind": "bars", "title": "세금·환율 뗀 뒤 순위", "sub": "막대 = 넣은 돈 1억보다 늘어난 만큼 · 2025.10.2 하루에 넣은 경우", "source": "거래소 종가·분배금(야후 파이낸스·나스닥, SCHD 분배금은 찰스슈왑 원문) · 원/달러 ECOS 731Y001 · 과거 값 · 미래 보장 아님 · 투자 권유 아님", "chapter": "6장", "data": {"dir": "v", "max": 17000000, "tags": true, "bars": [["SCHD", 15987335, "1억 1,599만원", 223, "accent", "+15.99%"], ["S&P500", 10225307, "1억 1,023만원", 341, "ink", "+10.23%"], ["금", 3365122, "1억 337만원", 355, "ink", "+3.37%"], ["예금", 2182680, "1억 218만원", 369, "ink", "+2.18%"]], "note": ["세금 떼기 전에도 같은 순서", 357], "circle": [0, 243]}, "lines": [{"text": "자, 이제 처음 질문으로 돌아갈게요. 세금과 환율을 다 떼면 순위가 바뀌었을까요?", "cap": null, "frames": 158, "audio": "audio/r-1/9d7c379fb587e219.wav"}, {"text": "답은, 안 바뀌었습니다.", "cap": null, "frames": 65, "audio": "audio/r-1/95dc0a800ee18542.wav"}, {"text": "세금 떼기 전에도, 뗀 뒤에도 SCHD가 맨 위예요.", "cap": null, "frames": 104, "audio": "audio/r-1/8de1a50d2c6cad2a.wav"}, {"text": "그다음이 S&P500, 그리고 금, 마지막이 예금이에요.", "cap": "세금 전·세금 뒤 모두 SCHD > S&P500 > 금 > 예금", "frames": 119, "audio": "audio/r-1/b0f1823dd39f4c17.wav"}], "frames": 446}, {"key": "gap", "kind": "count", "title": "달라진 건 간격", "sub": "SCHD와 예금, 통장에 남은 돈의 차이", "source": "거래소 종가·분배금(야후 파이낸스·나스닥, SCHD 분배금은 찰스슈왑 원문) · 원/달러 ECOS 731Y001 · 소득세법 제94·103·104·110조", "chapter": "6장", "data": {"from": 16876863, "to": 13804655, "text": "13,804,655원", "label": "SCHD − 예금, 세금 뗀 뒤", "start": 290, "pre": "세금 떼기 전 16,876,863원", "preAt": 146, "cut": "세금이 줄인 간격 3,072,208원", "cutAt": 397, "callout": ["많이 번 쪽이 세금도 많이 낸다", 505]}, "lines": [{"text": "그럼 세금은 아무것도 안 바꿨을까요? 순위 대신 간격을 바꿨어요.", "cap": null, "frames": 146, "audio": "audio/r-1/d1ce44ef924120be.wav"}, {"text": "세금 떼기 전에는 SCHD와 예금 차이가 약 1,688만원이었어요.", "cap": "세금 전 차이 16,876,863원", "frames": 144, "audio": "audio/r-1/a6ef7884ab51c1a0.wav"}, {"text": "세금을 떼고 나니 1,380만원으로 줄었어요.", "cap": "세금 뒤 차이 13,804,655원", "frames": 107, "audio": "audio/r-1/6196cdce344fa4b5.wav"}, {"text": "맨 처음에 말씀드린 307만원이 바로 이 차이예요.", "cap": null, "frames": 108, "audio": "audio/r-1/c4b6977378398a42.wav"}, {"text": "많이 번 쪽이 세금도 많이 내니까 간격이 좁혀지는 거고, 그래도 예금이 따라잡을 만큼은 아니었던 거죠.", "cap": null, "frames": 193, "audio": "audio/r-1/df6e78a16fb9dfeb.wav"}], "frames": 698}, {"key": "start", "kind": "bars", "title": "넣는 날을 바꾸면 순위도 바뀐다", "sub": "시작일 251개(2024.10.2~2025.10.2)마다 1년 들고 판 결과 · 세 ETF 순서별 날 수", "source": "야후 파이낸스 종가·분배금 · 달러 기준·세금 전(파이어맵 계산)", "chapter": "6장", "data": {"dir": "v", "max": 175, "tags": true, "bars": [["금>S&P>SCHD", 153, "153일", 169, "ink", null], ["금>SCHD>S&P", 34, "34일", 177, "ink", null], ["SCHD>금>S&P", 34, "34일", 185, "ink", null], ["SCHD>S&P>금", 25, "25일", 193, "accent", null], ["S&P>금>SCHD", 4, "4일", 201, "ink", null], ["S&P>SCHD>금", 1, "1일", 209, "ink", null]], "circle": [3, 317], "note": ["오늘 순서: 251일 중 25일(10.0%)", 327], "note2": ["금이 1위: 187일(74.5%)", 445]}, "lines": [{"text": "그런데 여기서 반론이 하나 나와요. 넣은 날이 하필 그날이라서 그런 거 아니냐는 거죠.", "cap": null, "frames": 159, "audio": "audio/r-1/5e2a8bef0744b4d2.wav"}, {"text": "그래서 넣는 날을 하루씩 옮겨 가며, 1년씩 들고 판 결과를 다 줄 세워 봤어요.", "cap": "시작일 2024.10.2~2025.10.2 거래일 251개 · 달러 기준 · 가격+분배금 · 세금 전 · 세 ETF끼리만", "frames": 158, "audio": "audio/r-1/63304234d504909b.wav"}, {"text": "오늘 영수증과 같은 순서가 나온 날은 열 번에 한 번꼴이었어요.", "cap": "SCHD > SPY > 금 — 251일 중 25일 (10.0%)", "frames": 128, "audio": "audio/r-1/e2046cb8eb055b2a.wav"}, {"text": "오히려 금이 1등인 날이 훨씬 많았고요.", "cap": "금이 1위 — 251일 중 187일 (74.5%)", "frames": 88, "audio": "audio/r-1/9a5daa7ee17b9048.wav"}, {"text": "그러니까 이 영상의 결론은 어디가 낫다가 아니에요. 세금과 환율이 간격을 얼마나 줄이느냐예요.", "cap": null, "frames": 194, "audio": "audio/r-1/2c339adc7beee8d5.wav"}, {"text": "순위는 넣는 날 따라 바뀌어도, 세금과 환율이 깎는 방식은 매번 똑같거든요.", "cap": null, "frames": 150, "audio": "audio/r-1/42af88558ede59d0.wav"}], "frames": 877}, {"key": "caseA", "kind": "person", "title": "30대 · 1년 안에 꺼낼 돈", "sub": "예: 집 계약금 — 꺼내는 날이 정해진 돈", "source": "야후 파이낸스 종가 × 한국은행 ECOS 731Y001 매매기준율(파이어맵 계산)", "chapter": "7장", "data": {"who": "30대", "what": "1년 안에 꺼낼 돈", "dir": "h", "min": 7000, "max": 14200, "tags": false, "bars": [["예금", 10218, "102,182,680원", 244, "ink", "처음부터 정해짐", 10000, "1억"], ["S&P500", 12304, "123,037,245원", 366, "accent", "꺼내는 날에 따라", 9729, "97,294,730원"]], "callout": ["폭 2,574만원", 390]}, "lines": [{"text": "이 영수증을 사람에 따라 다시 읽어 볼게요.", "cap": null, "frames": 101, "audio": "audio/r-1/1ae07b5da9cddbd2.wav"}, {"text": "1년 안에 꺼내야 하는 돈을 가진 30대예요. 집 계약금 같은 돈이요.", "cap": null, "frames": 143, "audio": null}, {"text": "예금이면 1년 뒤 받을 돈이 처음부터 정해져 있어요.", "cap": null, "frames": 122, "audio": "audio/r-1/12e0278f57f678eb.wav"}, {"text": "S&P500이었다면 꺼내는 날에 따라 2,574만원 폭으로 달라졌어요.", "cap": "SPY 1억 원화 평가액 최저 97,294,730원(2025.10.10) ~ 최고 123,037,245원(2026.7.2)", "frames": 172, "audio": "audio/r-1/03b9101cc76526bb.wav"}, {"text": "날짜가 정해진 돈이라면, 수익률보다 이 폭이 더 중요하다는 뜻입니다.", "cap": null, "frames": 158, "audio": "audio/r-1/17b3af864062b089.wav"}, {"text": "예금은 이 폭이 없는 대신, 얻는 것도 2% 남짓으로 정해져 있다는 게 대가고요.", "cap": null, "frames": 177, "audio": "audio/r-1/509b8c2ee686175c.wav"}], "frames": 873}, {"key": "sum", "kind": "receipt", "title": "정리 — 1억의 1년 영수증", "sub": "2025.10.2 → 2026.10.2 · 세금과 환율을 다 뗀 뒤", "source": "거래소 종가·분배금(야후 파이낸스·나스닥, SCHD 분배금은 찰스슈왑 원문) · 원/달러 ECOS 731Y001 · 과거 값 · 미래 보장 아님 · 투자 권유 아님", "chapter": "8장", "data": {"head": "세금 다 낸 뒤 남는 돈", "side": ["순위 그대로", 453, "하지만 넣는 날이 바뀌면 순위도 바뀜"], "rows": [["SCHD  +15.99%", "1억 1,599만원", "net", 146], ["S&P500  +10.23%", "1억 1,023만원", "in", 170], ["금  +3.37%", "1억 337만원", "in", 310], ["예금  +2.18%", "1억 218만원", "in", 334]]}, "lines": [{"text": "정리해 볼게요. 작년 그날 넣은 돈은 세금과 환율을 다 떼고 이렇게 됐어요.", "cap": null, "frames": 146, "audio": "audio/r-1/f4815ccc30389c3d.wav"}, {"text": "SCHD는 16% 가까이 늘었고, SPY는 10% 조금 넘게요.", "cap": "세금 다 낸 뒤 SCHD 1억 1,599만원(+15.99%) · S&P500 1억 1,023만원(+10.23%)", "frames": 164, "audio": "audio/r-1/bad39ad48cb83509.wav"}, {"text": "금은 3% 조금 넘게, 예금은 2% 조금 넘게 늘었어요.", "cap": "금 1억 337만원(+3.37%) · 예금 1억 218만원(+2.18%)", "frames": 143, "audio": "audio/r-1/4dfd455515f5f489.wav"}, {"text": "순위는 그대로였고, 세금은 간격을 줄였어요. 하지만 넣는 날이 바뀌면 순위도 쉽게 바뀌었죠.", "cap": null, "frames": 203, "audio": "audio/r-1/c69f474894979719.wav"}, {"text": "결국 같은 1억이라도, 언제 쓸 돈이냐에 따라 읽는 법이 달라진다는 거예요.", "cap": null, "frames": 159, "audio": null}], "frames": 815}, {"key": "end", "kind": "end", "title": "다음 영수증은 2편에서", "sub": "1억의 1년 영수증 시리즈 · 재생목록에 차례대로", "source": "과거 값 · 미래 보장 아님 · 투자 권유 아님", "chapter": "8장", "data": {"text": "다음 편", "label": "1억의 1년 영수증", "note": "같은 규칙으로, 실제 그날 넣었다면", "start": 484}, "lines": [{"text": "이제 여러분 차례예요. 오늘 이런 돈이 생긴다면, 어디에 두시겠어요?", "cap": null, "frames": 143, "audio": "audio/r-1/46f5ec0a873d1522.wav"}, {"text": "그리고 그 돈은 언제 쓰실 돈인가요? 댓글로 남겨 주시면 다음 영수증을 고를 때 참고할게요.", "cap": null, "frames": 188, "audio": "audio/r-1/e8da975cffbc5289.wav"}, {"text": "오늘 숫자는 모두 지나간 1년 값이고, 어디에 넣으라는 말은 아닙니다.", "cap": null, "frames": 153, "audio": "audio/r-1/c606876efe3ee64e.wav"}, {"text": "다음 편에서도 같은 규칙으로, 실제 그날 넣었다면 얼마가 남는지 영수증을 뽑아 올게요.", "cap": null, "frames": 194, "audio": "audio/r-1/872a4d1f2f020474.wav"}, {"text": "시리즈는 재생목록에 차례대로 모아 둘게요. 구독해 두시면 다음 영수증이 나올 때 바로 보실 수 있습니다.", "cap": null, "frames": 229, "audio": "audio/r-1/bdda9da828f8e16c.wav"}, {"text": "오늘도 끝까지 봐 주셔서 고마워요.", "cap": null, "frames": 88, "audio": "audio/r-1/4b0efce1ff3c080d.wav"}], "frames": 995}], "missing": 2, "script": "script.v7.md", "rate": 5.65}