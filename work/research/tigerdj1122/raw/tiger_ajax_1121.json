[{"url": "https://investments.miraeasset.com/tigeretf/ko/product/chart/prdct-profit-list.ajax?ksdFund=&strtDt=&endDt=&period=", "body": "{\"rtnData\":[]}"}, {"url": "https://investments.miraeasset.com/tigeretf/ko/product/search/detail/price.ajax", "body": "<div>\n<div class=\"board-list-none\"><div class=\"txt\">검색 결과가 없습니다.</div></div>\n\t</div>"}, {"url": "https://investments.miraeasset.com/tigeretf/ko/product/search/detail/profit.ajax", "body": "<div>\n\t\t\t <div class=\"board-list-none\"><div class=\"txt\">검색 결과가 없습니다.</div></div>\n\t\t\t\t </div>\n\t "}, {"url": "https://investments.miraeasset.com/tigeretf/ko/product/search/detail/pdf.ajax", "body": "<!-- 테이블 보기 -->\n<div class=\"tab-data actived\">\n\t\t\t<form id=\"formPdfList\">\n\t\t\t\t<input type=\"hidden\" name=\"ksdFund\"  value=\"\" title=\"번호\" />\n\n\t\t\t\t<input type=\"hidden\" name=\"pageIndex\" value=\"1\" title=\"페이지번호\" />\n\t\t\t\t<input type=\"hidden\" name=\"firstIndex\" value=\"0\" title=\"조회할 첫번째 순서\" />\n\t\t\t\t<input type=\"hidden\" name=\"listCnt\" value=\"10\" title=\"조회할 갯수\" />\n\n                <style>\n                    .pdf-sort-group-type01 .form-datepicker-group::after{display:none;}\n                    /* 수익률 헤더 툴팁 : 마지막 컬럼이라 왼쪽으로 열리게 보정 */\n                    th.notice .toast-data-wrap{display:inline-flex;vertical-align:middle;}\n                    th.notice .toast-data-group{margin-right:0;}\n                    th.notice .new-toast-popup .toast-pop-data{left:auto;right:100%;}\n                    th.notice .new-toast-popup .toast-pop-inner{left:auto;right:1rem;text-align:left;font-weight:400;}\n                    th.notice .new-toast-popup .toast-pop-inner::after{left:auto;right:-10px;transform:rotate(90deg);}\n                    #formPdfList .data-view-sort .sort-value:before{display:none;}\n                    .tab-button-type01 .tab-button-list{\n                        background:transparent;\n                    }\n                    .tab-button-type01 .list-type-btn-wrap > li{\n                        border:0;\n                        margin-left:20px;\n                    }\n                    .tab-button-type01 .list-type-btn-wrap > li.actived{\n                        border:0;\n                        background-color:transparent;\n                    }\n                    .basic-data-group .tab-button-type01 .tab-button-list > li.actived .btn-tab-list-item{\n                        color:#193d71;\n                    }\n                    .basic-data-group .tab-button-type01 .tab-button-list > li.actived .btn-tab-list-item::after{\n                        display:none;\n                    }\n                </style>\n\t\t\t\t<div class=\"data-view-sort\">\n\t\t\t\t\t<div class=\"sort-left\" style=\"display: flex; align-items: center;\">\n\t\t\t\t\t\t<div class=\"sort-group pdf-sort-group-type01\">\n\t\t\t\t\t\t\t<div class=\"sort-label\">기준일 </div>\n\t\t\t\t\t\t\t<div class=\"\">\n\t\t\t\t\t\t\t\t<div class=\"form-datepicker-group\">\n\t\t\t\t\t\t\t\t\t<div class=\"form-date\"><input type=\"text\" name=\"fixDate\" class=\"middle-size datepicker\" value=\"2026.11.21\" placeholder=\"시작일\" title=\"기준일조회 시작일\" tabindex=\"0\"></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"sort-group\">\n\t\t\t\t\t\t\t<div class=\"sort-value\">\n\t\t\t\t\t\t\t\t<select title=\"기준일 기간 선택\" name=\"prfPrd\" class=\"form-select basic-select middle-size\">\n\t\t\t\t\t\t\t\t\t<option value=\"Week01\" >1주</option>\n\t\t\t\t\t\t\t\t\t<option value=\"Month01\" >1개월</option>\n\t\t\t\t\t\t\t\t\t<option value=\"Month03\" >3개월</option>\n\t\t\t\t\t\t\t\t\t<option value=\"Month06\" >6개월</option>\n\t\t\t\t\t\t\t\t\t<option value=\"Year01\" >1년</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"sort-group\">\n\t\t\t\t\t\t\t<div class=\"sort-value\">\n\t\t\t\t\t\t\t\t<select title=\"정렬\" name=\"order\" class=\"form-select basic-select middle-size\">\n\t\t\t\t\t\t\t\t\t<option value=\"SRD\" >보유비중 내림차순</option>\n\t\t\t\t\t\t\t\t\t<option value=\"SRA\" >보유비중 오름차순</option>\n\t\t\t\t\t\t\t\t\t<option value=\"PRD\" >수익률 내림차순</option>\n\t\t\t\t\t\t\t\t\t<option value=\"PRA\" >수익률 오름차순</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<button type=\"button\" class=\"btn-basic btn-outline-whitegray btn-basic-auto btn-size-middle btn-round btn-data-inquiry btn_detail_search\" style=\"margin-left:20px;\">조회</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"tab-button-group tab-button-type01\" style=\"display: flex; align-items: center; gap: 0 1.25rem; margin-left: auto;\">\n\t\t\t\t\t\t<ul class=\"tab-button-list list-type-btn-wrap\">\n\t\t\t\t\t\t\t<!-- <li><button type=\"button\" class=\"btn-tab-list-item btn-list-type type-list\">테이블 보기</button></li>\n                            <li><button type=\"button\" class=\"btn-tab-list-item btn-list-type type-card\">트리맵 보기</button></li> -->\n\t\t\t\t\t\t\t<li id=\"tab10\" aria-controls=\"tab-panel10\" class=\"actived\">\n<button type=\"button\" class=\"btn-tab-list-item c-button for figured\" data-type=\"table\" onclick=\"console.log('태그에서 클릭이벤트');\" title=\"선택됨\">테이블 보기</button>\n                            </li>\n\t\t\t\t\t\t\t<li id=\"tab11\" aria-controls=\"tab-panel11\" class=\"\">\n<button type=\"button\" class=\"btn-tab-list-item c-button for figured\" data-type=\"treemap\" onclick=\"console.log('태그에서 클릭이벤트');\">트리맵 보기</button>\n                            </li>\n\t\t\t\t\t\t</ul>\n                        <a href=\"javascript:\" title=\"\" class=\"c-button for figured btn_detail_excel\" data-type=\"excel\">엑셀다운로드</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"data-view tbl-type02\">\n\t\t\t\t\t<div class=\"read-table-top\">\n\t\t\t\t\t\t<div class=\"top-right\">\n\t\t\t\t\t\t\t<div class=\"btn-item\">\n</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<!-- 2025-08-19 HDH : 레이어 팝업 디자인 개선 : type-new 추가 -->\n<div class=\"note-info small chart-info-box type-new\">\n\t<div class=\"title\">\n\t\t\n\t\t\t\t구성종목에 표시된 수익률의 경우 전영업일 기준의 수익률 입니다.\n\t\t\t</div>\n</div><div class=\"board-list-none\">\n\t<div class=\"txt\">\n\t\t검색 결과가 없습니다.</div>\n</div></div>\n\t\t\t</form>\n\t\t</div>\n\t\t<!-- //테이블 보기 -->\n\n\t\t<!-- 트리맵 보기 -->\n\t\t<div class=\"tab-data\">\n\t\t\t<div class=\"data-view-sort\">\n\t\t\t\t<div class=\"sort-left\" style=\"display: flex; align-items: center;\">\n\t\t\t\t\t<div class=\"sort-group pdf-sort-group-type01\">\n\t\t\t\t\t\t<div class=\"sort-label\">기준일 </div>\n\t\t\t\t\t\t<div class=\"\">\n\t\t\t\t\t\t\t<div class=\"form-datepicker-group\">\n\t\t\t\t\t\t\t\t<div class=\"form-date\"><input type=\"text\" name=\"fixDate\" class=\"middle-size datepicker\" value=\"2026.11.21\" placeholder=\"시작일\" title=\"기준일조회 시작일\" tabindex=\"0\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"sort-group\">\n\t\t\t\t\t\t<div class=\"sort-value\">\n\t\t\t\t\t\t\t<select title=\"기준일 기간 선택\" name=\"prfPrd\" class=\"form-select basic-select middle-size\">\n\t\t\t\t\t\t\t\t<option value=\"Week01\" >1주</option>\n\t\t\t\t\t\t\t\t<option value=\"Month01\" >1개월</option>\n\t\t\t\t\t\t\t\t<option value=\"Month03\" >3개월</option>\n\t\t\t\t\t\t\t\t<option value=\"Month06\" >6개월</option>\n\t\t\t\t\t\t\t\t<option value=\"Year01\" >1년</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<button type=\"button\" class=\"btn-basic btn-outline-whitegray btn-basic-auto btn-size-middle btn-round btn-data-inquiry btn_detail_search\">조회</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n                <div class=\"tab-button-group tab-button-type01\" style=\"display: flex; align-items: center; gap: 0 1.25rem; margin-left: auto;\">\n                    <ul class=\"tab-button-list list-type-btn-wrap\">\n                        <!-- <li><button type=\"button\" class=\"btn-tab-list-item btn-list-type type-list\">테이블 보기</button></li>\n                        <li><button type=\"button\" class=\"btn-tab-list-item btn-list-type type-card\">트리맵 보기</button></li> -->\n                        <li id=\"tab10\" aria-controls=\"tab-panel10\" class=\"actived\">\n                                <button type=\"button\" class=\"btn-tab-list-item c-button for figured\" data-type=\"table\" onclick=\"console.log('태그에서 클릭이벤트');\" title=\"선택됨\">테이블 보기</button>\n                        </li>\n                        <li id=\"tab11\" aria-controls=\"tab-panel11\" class=\"\">\n                                <button type=\"button\" class=\"btn-tab-list-item c-button for figured\" data-type=\"treemap\" onclick=\"console.log('태그에서 클릭이벤트');\">트리맵 보기</button>\n                        </li>\n                    </ul>\n                </div>\n\t\t\t</div>\n\t\t\t<div class=\"data-view treemap\">\n\t\t\t\t<div class=\"treemap-chart-content\">\n\t\t\t\t\t<div class=\"treemap-chart-title\">\n\t\t\t\t\t\t<div class=\"txt\">구성종목 수익률 기준</div>\n\t\t\t\t\t\t<div class=\"treemap-chart-sort\">\n\t\t\t\t\t\t\t<div class=\"btn-chart-sort-item\" style=\"background:rgba(237,40,15,1.0);\"><span class=\"value\">+15%</span></div>\n\t\t\t\t\t\t\t<div class=\"btn-chart-sort-item\" style=\"background:rgba(245,130,33,1.0);\"><span class=\"value number-state up white\">+10%</span></div>\n\t\t\t\t\t\t\t<div class=\"btn-chart-sort-item\" style=\"background:rgba(240,178,107,1.0);\"><span class=\"value number-state up white\">+5%</span></div>\n\t\t\t\t\t\t\t<div class=\"btn-chart-sort-item\" style=\"background:rgba(141,200,232,1.0);\"><span class=\"value number-state up white\">0%</span></div>\n\t\t\t\t\t\t\t<div class=\"btn-chart-sort-item\" style=\"background:rgba(0,134,184,1.0);\"><span class=\"value number-state up white\">-5%</span></div>\n\t\t\t\t\t\t\t<div class=\"btn-chart-sort-item\" style=\"background:rgba(4,59,114,1.0);\"><span class=\"value number-state up white\">-10%</span></div>\n\t\t\t\t\t\t\t<div class=\"btn-chart-sort-item\" style=\"background:rgba(5 28 50);\"><span class=\"value number-state white\">-15%</span></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<!-- 2025-08-19 HDH : 레이어 팝업 디자인 개선 : type-new 추가 -->\n<div class=\"note-info small chart-info-box type-new\">\n\t<div class=\"title\">\n\t\t\n\t\t\t\t구성종목에 표시된 수익률의 경우 전영업일 기준의 수익률 입니다.\n\t\t\t</div>\n</div><div class=\"treemap-chart-card-wrap\">\n\t\t\t\t\t\t<div class=\"treemap-chart-header\">\n\t\t\t\t\t\t\t<div class=\"header-title\"> ()</div>\n\t\t\t\t\t\t\t<div class=\"header-value\">\n\t\t\t\t\t\t\t\t<div class=\"value-cate\">1주</div>\n\t\t\t\t\t\t\t\t<!-- 변동없을때 -->\n\t\t\t\t\t\t\t\t\t\t<div class=\"value-number\"><span class=\"color-none\"><span class=\"blind\">없음</span>\n\t\t\t\t\t\t\t-</span></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"treemap-chart-data\">\n\t\t\t\t\t\t\t<div id=\"treeMapChart3\">\n\t\t\t\t\t\t\t\t<div id=\"treeMapChart_\" class=\"wj-control wj-flexchart wj-treemap\" style=\"width:100%;height:100%\"></div>\n<div class=\"btn-chart-view\"><button type=\"button\" class=\"btn-chart-detail\" data-key=\"\">구성종목 보기</button></div> <!-- 20220105 추가 -->\n<script type=\"text/javascript\">\n\t$(document).ready(function(){\n\n\t\tvar formNm = \"ksdFundFrm_\";\n\n\t\t//비동기 통신으로 데이터 조회\n\t\tcmmCtrl.bscAjax(function(data){\n\t\t\tif(data.rtnData != undefined && data.rtnData.length > 0)\n\t\t\t{\n\t\t\t\tvar ksdFund = data.rtnData[0].ksdFund;\n\t\t\t\tvar rtnDataList = data.rtnData;\n\t\t\t\t$.each(rtnDataList, function(i, data){\n\t\t\t\t\trtnDataList.sort(function(a, b){\n\t\t\t\t\t\treturn b.stockRate - a.stockRate;\n\t\t\t\t\t})\n\t\t\t\t})\n\t\t\t\tgetTreeMap(\"#treeMapChart_\" + ksdFund, data.rtnData);\n\t\t\t}\n\t\t}, \"/tigeretf/ko/product/chart/prdct-item-list.ajax?ksdFund=&prfPrd=&fixDate=&listCnt=20\", \"json\", false)\n\n\t})\n\n\t//현업이 정해준 박스 색\n\n\tfunction getTreeMap(treeId, data){\n\t\tvar nameField = \"ko\" == 'en' ? 'memItemnameEng' : 'memItemname';\n\t\t\n\t\tvar treemap = new wijmo.chart.hierarchical.TreeMap(treeId, {\n\t        binding: \"stockRate\", //비율\n\t        bindingName: nameField, //국문명\n\t        maxDepth : 0, // 최대 뎁스\n\t\t\tplotMargin : 0, //그래프영역 마진값 설정\n\t        itemsSource: data,\n\t        palette : getPalette(data),\n\t        dataLabel: {\n\t            position: 'Center',\n\t            content: '{'+nameField+'}'\n\t        },\n\t        tooltip : {\n\t\t\t\tcontent : function(hti){\n\n\t\t\t\t\tvar formNm = \"ksdFundFrm_\";\n\t\t\t\t\tvar rateTitl = \"ko\" == 'en'? 'Weighting' : '보유비중',\n\t\t\t\t\t\tprfTitl = \"ko\" == 'en' ? 'Yield' : \"수익률\";\n\t\t\t\t\tvar prfPrd = \"\",\t\n\t\t\t\t\t\tprfPrdStr = \"\";\n\t\t\t\t\t\n\t\t\t\t\tif( prfPrd == 'Week01' ){\n\t\t\t\t\t\tprfPrdStr =  \"ko\" == 'en' ? '1Week' : \"1주일\";\n\t\t\t\t\t}else if( prfPrd == 'Month01' ){\n\t\t\t\t\t\tprfPrdStr =  \"ko\" == 'en' ? '1Month' : \"1개월\";\n\t\t\t\t\t}else if( prfPrd == 'Month03' ){\n\t\t\t\t\t\tprfPrdStr =  \"ko\" == 'en' ? '3Month' : \"3개월\";\n\t\t\t\t\t}else if( prfPrd == 'Month06' ){\n\t\t\t\t\t\tprfPrdStr =  \"ko\" == 'en' ? '6Month' : \"6개월\";\n\t\t\t\t\t}else{\n\t\t\t\t\t\tprfPrdStr =  \"ko\" == 'en' ? '1Year' : \"1년\";\n\t\t\t\t\t}\n\n\t\t\t\t\tprfTitl =  prfPrdStr+prfTitl;\n\t\t\t\t\t\n\t\t\t\t\tvar pdfRate = hti.item.pdfRate == null ? '-' :  (hti.item.pdfRate).toFixed(2);\n\n\t\t\t\t\treturn '<div class=\"treemap-tooltip-wrap\"><div class=\"title\">'+hti.item[nameField]+'</div><div class=\"value\"><div class=\"name\">'+rateTitl+'(%)</div><div class=\"num\">'+hti.item.stockRate+'%</div></div><div class=\"value\"><div class=\"name\">'\n\t\t\t\t\t\t+prfTitl+'</div><div class=\"num\">'+pdfRate+'%</div></div></div>';\n\t\t\t\t}\n\t\t\t}\n\t    });\n\n\t\ttreemap.hostElement.addEventListener('click', function (e) {\n\t\t\t// get hittest object\n\t\t    var ht = treemap.hitTest(e);\n\t\t\tvar item = ht.item;\n\t\t\titem.prfPrd = '';\n\t\t\titem.fixDate = '';\n\n\t\t\tcmmCtrl.getTreeDtlPop(item);\n\t     });\n\t\t\n\t\t$(treemap.hostElement).next().find('.btn-chart-detail').on('click', function (e) {\n\t\t\tvar item = {\n\t\t\t\t\tksdFund : $(this).data(\"key\"),\n\t\t\t\t\tprfPrd : '',\n\t\t\t\t\tfixDate : ''\n\t\t\t\t};\n\t\t\tcmmCtrl.getTreeDtlPop(item, this);\n\t     });\n\n\n\t\t$(treemap.hostElement).removeAttr('tabindex');\n\n\t}\n\t//색 15~, 15~10, 10~5, 5~0, 0~-5, -5~-10, -10미만\n\tvar palettes =  ['rgba(237,40,15,1.0)' , 'rgba(245,130,33,1.0)' , 'rgba(240,178,107,1.0)' , 'rgba(141,200,232,1.0)', 'rgba(0,134,184,1.0)' , 'rgba(4,59,114,1.0)', 'rgba(5 28 50)'];\n\tfunction getPalette(data) {\n\t\t// 수익률기준\n\t\tvar arr = [];\n\t\tfor(var q = 0; q < data.length ; q++){\n\t\t\tif(data[q].pdfRate >= 15)\n\t\t\t{\n\t\t\t\tarr.push(palettes[0]);\n\t\t\t}\n\t\t\telse if( data[q].pdfRate < 15 && data[q].pdfRate >= 10)\n\t\t\t{\n\t\t\t\tarr.push(palettes[1]);\n\t\t\t}\n\t\t\telse if( data[q].pdfRate < 10 && data[q].pdfRate >= 5)\n\t\t\t{\n\t\t\t\tarr.push(palettes[2]);\n\t\t\t}\n\t\t\telse if( data[q].pdfRate < 5 && data[q].pdfRate >= 0)\n\t\t\t{\n\t\t\t\tarr.push(palettes[3]);\n\t\t\t}\n\t\t\telse if( data[q].pdfRate < 0 && data[q].pdfRate >= -5)\n\t\t\t{\n\t\t\t\tarr.push(palettes[4]);\n\t\t\t}\n\t\t\telse if( data[q].pdfRate < -5 && data[q].pdfRate >= -10)\n\t\t\t{\n\t\t\t\tarr.push(palettes[5]);\n\t\t\t}\n\t\t\telse if( data[q].pdfRate < -10)\n\t\t\t{\n\t\t\t\tarr.push(palettes[6]);\n\t\t\t}\n\t\t}\n\t\treturn arr;\n\t}\n</script></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<!-- //트리맵 보기 -->\n\t\t"}, {"url": "https://investments.miraeasset.com/tigeretf/ko/product/chart/prdct-item-list.ajax?ksdFund=&prfPrd=&fixDate=&listCnt=20", "body": "{\"rtnData\":[]}"}]