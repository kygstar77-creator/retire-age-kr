scenes[-1]['data']['src'] = 'bg/t1/5562942.mp4'
scenes[-1]['frames'] += END_PAD; scenes[-1]['data']['_need'] += END_PAD / FPS
scenes[-1]['lines'].append({'text': '', 'audio': None, 'frames': END_PAD, 'cap': None, 'i': None})

for s in scenes: assert s['kind'] != 'broll' or not re.search(r'\d', s['data']['say'] or ''), ('실사 say 숫자', s['data']['say'])
for s in scenes: assert s['kind'] not in ('broll', 'ask', 'brand', 'pic') or not any(l['cap'] for l in s['lines']), ('실사·카드에 cap', s['lines'][0]['text'][:20])
short = []
for s in scenes:
    d = s['data']
    if 'from_' in d:
        d['from'] = d.pop('from_')
        if d['_need'] > d['_have'] + 0.5: short.append((d['src'], d['_need'], d['_have']))
        d.pop('_need'); d.pop('_have')
assert not short, ('실사 클립이 말보다 짧다', short)
assert len(USED) == len(ALL), ('안 쓴 줄', [ALL[i]['text'][:24] for i in range(len(ALL)) if i not in USED])
order = [l['i'] for s in scenes for l in s['lines'] if l['i'] is not None]; assert order == sorted(order), '줄 순서'
scenes[-1]['frames'] += TAIL
for s in scenes:
    for l in s['lines']: l.pop('i')

# 화면 관문 어림: 판이 이어진 구간 최장(bgcheck '같은 판 20초'), 실사 몫
live = brk = 0; tot = sum(s['frames'] for s in scenes)
RUNS = []; run = 0; grp = []; mx = 0
for s in scenes:
    if s['kind'] in ('broll', 'pic'): live += s['frames']
    if s['kind'] in ('broll', 'ask', 'brand', 'pic'):
        brk += 1
        if run / FPS > 19.5: RUNS.append((round(run / FPS, 1), grp))
        run = 0; grp = []
    else: run += s['frames']; mx = max(mx, run); grp.append(s['data'].get('title'))
if run / FPS > 19.5: RUNS.append((round(run / FPS, 1), grp))
assert not RUNS, RUNS

# 숫자 대조(numcheck)
SKIP = {'pre', 'seed', 'audio', 'src', 'license', 'kind', 'icon', 'c', 'c1', 'c2', 'from', 'x', 'side', 'dir', 'max', 'at', 'at2', 'lit', 'done', 'step', 'mode', 'chapter', 'rv', 'hot'}
def strings(x):
    if isinstance(x, dict):
        for k, v in x.items():
            if k in SKIP: continue
            yield from strings(v)
    elif isinstance(x, list):
        for v in x:
            if not isinstance(v, (int, float)): yield from strings(v)
    elif isinstance(x, str): yield x
SRCDOC = CALC + SCRIPT
bad = []; nnum = 0
for s in scenes:
    for st in list(strings(s['data'])) + [l['cap'] for l in s['lines'] if l['cap']]:
        for d in re.findall(r'\d[\d,.]*', st):
            d = d.rstrip('.,'); nnum += 1
            if d not in SRCDOC: bad.append((st[:40], d))
assert not bad, bad

p = {'fps': FPS, 'scenes': scenes, 'badge': ''}
json.dump(p, open(os.path.join(VID, 'j1.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
used = sorted(USEDBG)
json.dump([{'id': c, 'used': USEDBG[c], 'desc_line': CR[c]['desc_line']} for c in used] + [{'id': k, 'used': 1, 'desc_line': JCR[int(os.path.basename(JB[k]['file']).split('.')[0])]['desc_line']} for k in dict.fromkeys(USEDJ) if JB[k]['kind'] == 'video'], open(os.path.join(EP, 'bg_used.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
print(f'J-1 j1.json: {tot} 프레임 = {tot / FPS:.1f}초 · 장면 {len(scenes)} · 줄 {len(ALL)} · 종류 {len(set(s["kind"] for s in scenes))}'
      f' · 실사 {live / tot * 100:.1f}%({live / FPS:.0f}초, 클립 {len(used)}개) · 바뀜 장면 {brk}(분당 {brk / (tot / FPS / 60):.1f}) · 판 이어짐 최장 {mx / FPS:.1f}초 · numcheck {nnum}덩이 불일치 0')
