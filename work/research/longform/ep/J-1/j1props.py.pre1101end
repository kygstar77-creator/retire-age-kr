# J-1 v5.5 화면 재료 — script.md(편집 서명 10/21 17:09) + voice.json(Chirp 3 HD Charon 1.1, 214줄) + calc·calc2·calc3·facts → work/video/j1.json (Remotion J1이 읽는다)
#   py -3.12 work/research/longform/ep/J-1/j1props.py
# 10/22 PD(02:1x 회차): t1props.py(같은 세금 주제 틀) + H3.tsx 꼴(종이 판·답 '?' 열기·장 카드 띠링·잔잔한 음)로 새로 짰다.
# 틀: 판(big·pair·rows·bars·table) ↔ 꽉 찬 실사(broll) ↔ 장 카드·댓글 카드(ask, 어두운 판). 가상 인물 없음(10/21 규칙) — 조건으로만 말한다.
# 실사: 지금은 T-1 실사 풀(public/bg/t1, 10/17 눈 검사 통과 Pexels)을 빌려 씀 → 장면 구상 담당의 shot_plan.md·bg_plan.json(bg/j1)이 나오면 CLIP 표만 바꾼다.
# 줄은 번호가 아니라 말 글자 앞부분으로 찾는다(대본이 바뀌면 assert). cap = 판 왼쪽 위 '정확한 값' 줄(22px 한 줄, 58자 안) — script.md [자막] 숫자를 그대로 줄여 쓴다.
# 숫자: props 안 숫자 글자는 전부 calc 셋·facts·script.md에 있는 글자만 — 맨 아래 numcheck가 기계로 막는다.
import json, os, re, sys
sys.stdout.reconfigure(encoding='utf-8')
EP = os.path.dirname(os.path.abspath(__file__))
WORK = os.path.normpath(os.path.join(EP, '..', '..', '..', '..'))
VID = os.path.join(WORK, 'video')
FPS, TAIL = 30, 75
END_PAD = 23 * 30   # 맺는 말 뒤 숨 3초 + 최종 화면 자리 20초(answer/6388789)
CALC = ''.join(open(os.path.join(EP, f), encoding='utf-8').read() for f in ('calc_out.txt', 'calc2_out.txt', 'calc3_out.txt', 'facts.txt'))
SCRIPT = open(os.path.join(EP, 'script.md'), encoding='utf-8').read()
V = json.load(open(os.path.join(EP, 'voice.json'), encoding='utf-8'))
ALL = [l for s in V['sections'] for l in s['lines']]
assert len(ALL) == 212, len(ALL)   # 10/22 editor: 07:07 두 줄 합침(과세표준·기준선) 반영 — 214 → 212
assert abs(V.get('speakingRate', 0) - 1.1) < 1e-9 and V['voice'] == 'ko-KR-Chirp3-HD-Charon'
USED = set()

# ── 실사 풀(빌림): T-1 credits.json + C-2 하늘 ──
CR = {c['id']: c for c in json.load(open(os.path.join(EP, '..', 'T-1', 'stock', 'credits.json'), encoding='utf-8'))}
CR[5562942] = {'id': 5562942, 'author': 'Daniel Qura', 'sec': 40, 'desc_line': '영상 일부: Daniel Qura / Pexels (https://www.pexels.com/video/time-lapse-video-of-the-sky-5562942/)'}

def L(t, cap=None):
    hit = [i for i, l in enumerate(ALL) if l['text'].startswith(t)]; assert len(hit) == 1, (t, hit)
    i = hit[0]; assert i not in USED, ('두 번 씀', t); USED.add(i)
    l = ALL[i]; assert l.get('audio') and os.path.exists(os.path.join(VID, 'public', l['audio'])), t
    assert cap is None or len(cap) <= 60, ('cap 길다', len(cap), cap)
    return {'text': l['text'], 'audio': l['audio'], 'frames': l['frames'], 'cap': cap, 'i': i}

def S(kind, lines, rvl=None, **data):
    ls = [L(*t) if isinstance(t, tuple) else L(t) for t in lines]
    if rvl is not None: data['rv'] = sum(l['frames'] for l in ls[:rvl]) + 8   # 답 '?' → 이 줄이 시작하고 8프레임 뒤 열림
    return {'kind': kind, 'lines': ls, 'frames': sum(l['frames'] for l in ls), 'data': data}

SRC_ME = '파이어맵 계산 · 55세·보유 10년·공시가격 그대로 가정 · 정부안(국회 통과 전)'
SRC_ME0 = '파이어맵 계산 · 공시가격 그대로 가정 · 정부안(국회 통과 전)'   # 10/22 editor: 나이·햇수가 55세·10년이 아닌 판(조건은 제목에)
SRC_GOV = '재정경제부 2026 세제개편안 상세본 · 의안 2221046 · 파이어맵 계산'
SRC_LAW = '종합부동산세법(법제처 2026.10.19)'
R = 'rise'; A = 'accent'; B = 'fall'; K = 'ink'
def big(title, v, s, lines, c=A, src=SRC_ME, **d): return S('big', lines, title=title, v=v, s=s, c=c, source=src, **d)
def pair(title, a, b, lines, src=SRC_ME, **d): return S('pair', lines, title=title, v1=a[0], s1=a[1], c1=a[2], v2=b[0], s2=b[1], c2=b[2], source=src, **d)
def rows(title, rs, lines, src=SRC_GOV, **d): return S('rows', lines, title=title, rows=rs, source=src, **d)
def bars(title, bs, lines, mx, dir='h', src=SRC_ME, **d): return S('bars', lines, title=title, bars=bs, max=mx, dir=dir, source=src, **d)
def table(title, cols, rs, lines, lit, src=SRC_GOV, **d): return S('table', lines, title=title, cols=cols, rows=rs, lit=lit, source=src, **d)
def ask(n, q, frm, lines): return S('ask', lines, n=n, q=q, **({'from': frm} if frm else {}))
USEDBG = {}
def broll(cid, lines, say, side='left', x=None):
    c = CR[cid]; k = USEDBG.get(cid, 0); USEDBG[cid] = k + 1; have = (c.get('sec') or 0) - 0.5
    s = S('broll', lines, src=f'bg/t1/{cid}.mp4', license=f"Pexels {cid} 무료({c['author']})", say=say, side=side, **({'x': x} if x is not None else {}))
    sec = s['frames'] / FPS; frm = 0 if k == 0 else int(min(max(0, have - sec), k * 6))   # 같은 클립을 다시 쓰면 다른 구간
    s['data']['from_'] = frm * FPS; s['data']['_need'] = round(sec + frm, 1); s['data']['_have'] = have
    return s


# 10/22 PD: 장면 구상 담당 재료(shot_plan.md · bg_plan.json · public/bg/j1, 새 심사 Agent 3차 판정 '같음·나음'만) — 키 'r02' 등. 사진(AI)은 pic(천천히 다가가기·'AI 생성 그림' 표시)
JB = {c['id'].replace('j1_', ''): c for c in json.load(open(os.path.join(EP, 'bg_plan.json'), encoding='utf-8'))['clips']}
JCR = {c['id']: c for c in json.load(open(os.path.join(VID, 'public', 'bg', 'j1', 'stock', 'credits.json'), encoding='utf-8'))}
USEDJ = []
def jb(key, lines, say):
    c = JB[key]; USEDJ.append(key)
    if c['kind'] == 'image':
        return S('pic', lines, pic=c['file'], license='AI 생성 그림(' + c['license'].replace('자체 생성 ', '') + ')', badge='AI 생성 그림', zoom=[1.0, 1.08])
    pid = int(os.path.basename(c['file']).split('.')[0]); cr = JCR[pid]
    s = S('broll', lines, src=c['file'], license=f"Pexels {pid} 무료({cr['author']})", say=say, side='left')
    s['data']['from_'] = 0; s['data']['_need'] = round(s['frames'] / FPS, 1); s['data']['_have'] = c['usable_sec']
    return s

