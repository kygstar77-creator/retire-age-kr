        return '사는 값과 빌려 사는 값', '84㎡대 · 회색 긴 막대 = 매매 가운데 값 · 색 막대 = 신규 순수전세 가운데 값 · % = 전세가율', SRC_RT, {
            'rows': rows, 'max': 60, 'deposit': 9.5, 'depositTxt': '손품 씨 보증금 9.50억',
            'steps': {str(has('가장 쌌던')): ['매매는 가장 비싸고, 전세는 가장 쌈', '잠실 안 84㎡대 거래 3건 이상 8단지 중', 'accent']}}
    if key == 'r_under':
        L8 = ['주공아파트5단지', '우성아파트', '쌍용대치아파트1동,2동,3동,5동,6동', '반포미도', '대치우성아파트1동,2동,3동,5동,6동,7동', '현대', '은마', '잠실포스코더샵']
        rows = [[nm(n), CX[n]['rent'], eok(CX[n]['rent']), CX[n]['built'], 'old' if CX[n]['built'] < 1990 else 'new', CX[n]['rent_n']] for n in L8]
        assert all(r[1] <= 9.5 for r in rows) and sum(1 for r in rows if r[4] == 'old') == 6
        rest = sorted([CX[n]['rent'] for n in CX if CX[n]['rent'] and n not in L8])
        assert rest[0] > 9.5, rest[0]
        return '보증금 9억 5천만원 안의 전세', '84㎡대 신규 순수전세 가운데 값 9.50억 이하 · 세 동네 28단지 중 8곳', SRC_RT, {
            'rows': rows, 'max': 10, 'deposit': 9.5,
            'steps': [None, ['8곳 중 6곳이 1990년 전 단지', '회색 막대', 'ink', 'old'], ['나머지 둘', '잠실 현대(1990) · 잠실포스코더샵(2004, 3건)', 'accent', 'new'],
                      ['왜 낮은지는', '실거래 자료로 알 수 없음', 'ink', None], ['어디로 가라는 말이 아니라', '보증금 안에 드는 곳을 센 계산', 'accent', None]]}
    if key == 'w_map':
        return '걸어서 잰 거리', '단지 가운데 → 지하철 출입구 · 오픈스트리트맵 보행로 · 대치·잠실만', SRC_MAP, {
            'views': [view(['은마'], 1.5, 1000, wpts('은마')), view(['리센츠'], 1.5, 1000, wpts('리센츠')), view(['은마', '리센츠'], 1.15)],
            'focus': ['은마', '리센츠'], 'old': OLD, 'color': 'age', 'routes': [['은마', 'station'], ['리센츠', 'station']], 'labels': ['은마', '리센츠'],
            'cards': [['은마 → 대치역 출입구', '270m', '1979년 단지'], ['리센츠 → 잠실새내역 출입구', '270m', '2008년 단지'], ['가장 가까운 두 곳', '오래된 하나, 새 하나', '']]}
    if key == 'w_ruler':
        R = [['은마', 270, 'old'], ['리센츠', 270, 'new'], ['주공5단지', 430, 'old'], ['잠실엘스', 500, 'new'], ['래미안대치팰리스', 530, 'new'], ['대치르엘', 1010, 'new']]
        return '역 출입구까지 걷는 거리', '단지 가운데 → 지하철 출입구 · 오픈스트리트맵 보행로 · 회색 = 1990년 전 단지', SRC_MAP, {
            'rows': [[a, m, f'{m:,}m', o] for a, m, o in R], 'max': 1100,
            'steps': [['5단지 430m · 잠실엘스 500m', '조금 더 걸음', 'ink', [2, 3]], ['대치 새 단지가 더 멂', '래미안대치팰리스 530m · 대치르엘 1,010m', 'accent', [4, 5]],
                      ['반포는 재지 않음', '길 자료를 받지 못함', 'ink', []]]}
    if key == 'e_table':
        T = [['잠실', '주공아파트5단지'], ['잠실', '리센츠'], ['대치', '은마'], ['대치', '래미안대치팰리스'], ['반포', '반포미도'], ['반포', '래미안원베일리']]
        WALK = {'주공아파트5단지': '430m', '리센츠': '270m', '은마': '270m', '래미안대치팰리스': '530m', '반포미도': '확인 안 함', '래미안원베일리': '확인 안 함'}
        rows = [[g, nm(n), str(CX[n]['built']), man(CX[n]['ppy']), eok(CX[n]['rent']), WALK[n]] for g, n in T]
        return '세 동네, 오래된 단지와 새 단지', '84㎡대 · 평당·전세는 1년 가운데 값 · 전체 표는 파이어맵 카페 · 계산·비교 자료, 사고팔라는 권유 아님', SRC_MAP + ' · cafe.naver.com/firemap', {
            'cols': ['동네', '단지', '지은 해', '평당', '전세', '역까지(걸어서)'], 'rows': rows, 'cafe': 'cafe.naver.com/firemap', 'old': [1, 0, 1, 0, 1, 0]}
    raise KeyError(key)


def script_lines(path):
    out, cur, last = {}, None, None
    for line in open(path, encoding='utf-8').read().split('\n---', 1)[0].splitlines():
        if line.startswith('## '):
            t = line[3:].strip(); cur = re.sub(r'^\[', '', t).split()[0].rstrip(']'); out[cur] = []; last = None
        elif cur is not None and line.lstrip().startswith('- '):
            t = re.sub(r'\s*\(화면.*$', '', line.strip()[2:]).strip(); t = re.sub(r'\s*\[자막:.*?\]', '', t).strip()
            if t: out[cur].append([t, None]); last = out[cur][-1]
        elif cur is not None and line.strip().startswith('[자막:') and last is not None:
            c = line.strip()[4:].rstrip(']').strip()
            c = re.sub(r'\s*\((?:H-1 )?calc_out \d+\)', '', c)
            last[1] = c
    return out


def clean(t): return re.sub(r'\s*\(재사용 \d+장\)', '', t).strip()


def main():
    sl = script_lines(os.path.join(EP, 'script.md'))
    voice = {}
    vj = json.load(open(os.path.join(EP, 'voice.json'), encoding='utf-8'))
    for s in vj.get('sections', []):
        for l in s['lines']:
            if l.get('audio'): voice[clean(l['text'])] = l
    scenes, warn = [], []
    for ch in ['0.', '1.', '2.', '3.', '4.', '5.', '6.', '7.']:
        lines = sl.get(ch, [])
        found = []
        for key, kind, c, anc in RULES:
            if c != ch: continue
            if anc is None: idx = 0
            else: idx = next((i for w in anc for i, (t, _) in enumerate(lines) if w in t), None)
            if idx is None: warn.append(f'{key}: {anc} 못 찾음 — 장면 뺌'); continue
            if any(i == idx for i, *_ in found): warn.append(f'{key}: 시작 줄이 다른 장면과 같음 — 뺌'); continue
            found.append((idx, key, kind))
        found.sort()
        if found and found[0][0] != 0: found[0] = (0,) + found[0][1:]
        for j, (idx, key, kind) in enumerate(found):
            part = lines[idx:(found[j + 1][0] if j + 1 < len(found) else None)]
            out = []
            for t, cap in part:
                ct = clean(t); v = voice.get(ct)
                fr = v['frames'] if v else max(12, round(SC.syl(SC.speak(ct)) / RATE * FPS))
                out.append({'text': ct, 'cap': cap, 'frames': fr, 'audio': v['audio'] if v else None})
            title, sub, src, data = spec(key, [x['text'] for x in out])
            frames = sum(x['frames'] for x in out)
            scenes.append({'key': key, 'kind': kind, 'title': title, 'sub': sub, 'source': src, 'chapter': CH_NAME[ch], 'data': data, 'lines': out, 'frames': frames})
    scenes[-1]['frames'] = max(scenes[-1]['frames'], END_MIN)
    missing = sum(1 for s in scenes for l in s['lines'] if not l['audio'])
    nlines = sum(len(v) for v in sl.values())
    res = {'fps': FPS, 'scenes': scenes, 'missing': missing, 'maps': MAPS, 'mapBox': [MW, MH]}
    json.dump(res, open(os.path.join(VID, 'h2.json'), 'w', encoding='utf-8'), ensure_ascii=False, separators=(',', ':'))
    tot = sum(s['frames'] for s in scenes) / FPS
    for w in warn: print('경고 ·', w)
    print(f'장면 {len(scenes)} · 말 줄 {nlines} · 길이 {int(tot // 60)}:{tot % 60:04.1f} · 목소리 없는 줄 {missing} · 그림 종류 {len({s["kind"] for s in scenes})} {sorted({s["kind"] for s in scenes})}')
    t = 0
    for i, s in enumerate(scenes):
        print(f"  {i:2} {int(t // 60)}:{t % 60:04.1f} {s['key']:10} {s['kind']:8} {s['frames'] / FPS:5.1f}초 줄{len(s['lines']):2}  {s['title']}")
        t += s['frames'] / FPS
    return res


if __name__ == '__main__':
    main()
