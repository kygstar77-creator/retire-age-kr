                    <script type="text/data" class="__se_module_data" data-module-v2='{"type": "v2_image", "id": "SE-92d3c2c2-fcd3-41aa-ba57-5e614d12b4b9", "data": {"ctype": "image", "ai": "false", "fileSize": "49702" }}'></script>
