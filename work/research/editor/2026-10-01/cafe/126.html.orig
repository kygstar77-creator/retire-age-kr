                    <script type="text/data" class="__se_module_data" data-module-v2='{"type": "v2_image", "id": "SE-58afd7bb-6ce6-4c54-8909-667377958888", "data": {"ctype": "image", "ai": "false", "fileSize": "29640" }}'></script>
