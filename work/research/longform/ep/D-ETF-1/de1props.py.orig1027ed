    bars('2022년 가장 많이 빠졌을 때', [['S&P500', 24.5, '-24.5%', G, 0], ['VIG', 20.4, '-20.4%', G, 0], ['DGRO', 19.3, '-19.3%', G, 0], ['SCHD', 16.8, '-16.8%', A, 0],
         ['HDV', 15.4, '-15.4%', G, 0], ['JEPI', 13.7, '-13.7%', G, 0]], [('S&P500은 25% 가까이', '2022년 한 해 안 최대 낙폭(분배 재투자)')], 26),
    rows('2020년 코로나 때 가장 많이 빠졌을 때', [['SPYD', '-46.4%'], ['S&P500', '-33.7%'], ['SCHD', '-33.4%']], [('그런데 늘 덜 빠지는 건', '2020년 이후 최대 낙폭 · SCHD·S&P500 둘 다 2020-03-23')]),
    broll(5366344, ['코로나 때 SPYD는'], '고른 ETF가 실제로 어땠는지를 본다'),
]
# ── 5. 1억 넣으면 1년에 얼마 ──
scenes += [
    ask('5장', '1억 넣으면 1년에 얼마?', '최근 12개월 분배가 앞으로 같다고 놓은 계산 · 가격·환율 변동 뺌', ['이제 1억을 넣었을 때']),
    pair('세금 떼는 곳', ['미국에서 15%', '미국 상장', K], ['많아야 15.4%', '국내 상장 · 국내에서 더', A],
         ['세금은 어디에 상장됐느냐', ('미국에 상장된 ETF는', '미국 원천징수 15%(한미 조세조약) · 국내 추가 0'), ('국내에 상장된 미국배당다우존스도', '실제 세액은 분배마다 운용사 과세표준 공시')], src='소득세법 §129', at2=2),
    broll(5480588, ['그러니까 업종은 SCHD와 같아도'], '업종은 같아도, 세금 떼는 곳은 다르다'),
    ask('지식iN 질문', 'TIGER 미국배당다우존스 배당금, 세금 떼고 받나요?', '네 — 계좌에 찍히는 건 세금 뗀 뒤 돈 · 네이버 지식iN', ['지식인에 TIGER 미국배당다우존스']),
    rows('1억 → 1년 통장 · 세금 뗀 뒤', [['SCHD', '260만원 · 월 22만원', None, 0], ['JEPI', '680만원 · 월 57만원', None, 2]],
         [('세금을 뗀 결과를 보면 SCHD', 'SCHD 2,609,500원 · JEPI 6,800,000원'), '한 달로 치면 22만원', 'JEPI는 680만원', '한 달로 57만원'], src=SRC_T),
    big('JEPQ · 세금 떼기 전', '1,170만원', '건보료 선은 세금 떼기 전 금액으로', [('그리고 JEPQ는 세금 떼기 전에', 'JEPQ 세전 11,710,000원')], rvl=0, src=SRC_T),
    ask('함정', '금융소득이 1년 1,000만원을 넘으면, 전부 건보료 계산에', '지역가입자 · 국민건강보험법 시행규칙 제44조①', ['지역가입자는 예금 이자와']),
    pair('1,000만원 선', ['1,170만원', 'JEPQ · 넘음', A], ['선 아래', '나머지 ETF', K], ['다른 이자가 없다면, 1억으로'], src=SRC_T, at2=0),
    rows('JEPQ 1억 · 지역가입자 · 1년', [['세금 떼기 전', '11,710,000원'], ['세금 15%', '−1,756,500원'], ['건보료 더 냄', '−952,585원'], ['손에 남는 돈', '9,000,915원', None, 2]],
         ['지역가입자로 놓고 계산하면', '건보료도 95만원', ('그래서 손에 남는 건 900만원', '월 750,076원 · 건보 7.19% + 장기요양 = 8.1348%')], src=SRC_T),
    ask('직장가입자는', '월급 말고 다른 소득이 2,000만원을 넘으면, 넘는 만큼', None, ['직장가입자는 월급 말고']),
    big('피부양자', '2,000만원', '다른 소득까지 합쳐 넘으면 자격을 잃는다', ['피부양자는 연금 같은'], c=K, src=SRC_T),
    broll(7118320, ['1억 기준으로는, 배당만으로'], '배당만으로 넘는 ETF는 없었다'),
    big('JEPQ + 국민연금', '2,000만원', '합계가 넘을 수 있다', ['그런데 JEPQ에 국민연금까지'], c=A, src=SRC_T),
    pair('원·달러 매매기준율', ['1,424원', '2025-10-16', K], ['1,349원', '2026-10-16', A], [('환율도 따져 봐야 합니다', '1,424.4원 → 1,348.5원 · ECOS 731Y001')], src='한국은행 ECOS', at2=0),
    broll(5981346, ['그래서 같은 달러를 원화로'], '같은 달러, 원화로는 덜 받는다'),
    pair('SCHD 1년 총수익(배당까지)', ['34%', '달러로', K], ['27%', '원화로', A], [('요즘 주춤했어도 열두 달 전에', '달러 33.8% · 원화 26.7%'), '원화로는 그보다 적은'], at2=1),
    broll(39494572, ['국내에 상장된 TIGER 미국배당다우존스도'], '원화로 사고팔아도 안에 든 건 달러 자산'),
    ask('댓글', '슈드 내리는건 문제가 안됨 문제는 환율이죠', '유튜브 댓글 · 좋아요 96 · 2026-10-19 수집', ['댓글에서 공감을 많이']),
]
# ── 6. 고르는 순서 ──
scenes += [
    ask('6장', '고르는 순서', '통장에 남는 돈까지 다섯 가지를 봤으니', ['통장에 남는 돈까지']),
    list5('고르는 순서', ['얼마 주나 · 12개월 다 더해서', '매년 느나 · 10년과 최근 3년', '한 업종에 몰렸나 · 겹치나', '떨어질 때 · 2022년·2020년'], ['먼저 얼마 주나, 다음은']),
    big('지금 생활비가 필요하면', '얼마 주나 · 떨어질 때', '그리고 1,000만원 선', ['지금 생활비가 필요한 분이라면'], c=K, src='파이어맵'),
    pic('map_paper', [('오래 모을 직장인이라면', '분배 연평균 증가 5년 · JEPI 0.2% · DGRO·VIG 7.4%')], z=(1.0, 1.06), cx=30, cy=60),
    pic('heatmap_paper', ['오늘 히트맵은 한 장으로'], z=(1.0, 1.02)),
    broll(7592927, ['같은 배당이라는 이름 아래'], '돈이 가 있는 곳은 저마다 달랐다'),
    broll(5562942, [ALL[-1]['text'][:8]], '다음 편'),
]
scenes[-1]['frames'] += END_PAD; scenes[-1]['data']['_need'] += END_PAD / FPS
scenes[-1]['lines'].append({'text': '', 'audio': None, 'frames': END_PAD, 'cap': None, 'i': None})

for s in scenes: assert s['kind'] != 'broll' or not re.search(r'\d', s['data']['say'] or ''), ('실사 say 숫자', s['data']['say'])
for s in scenes: assert s['kind'] not in ('broll', 'ask', 'brand', 'pic') or not any(l['cap'] for l in s['lines']) or s['kind'] == 'pic', ('실사·카드에 cap', s['lines'][0]['text'][:20])
short = []
for s in scenes:
    d = s['data']
    if 'from_' in d:
        d['from'] = d.pop('from_')
        if d['_need'] > d['_have'] + 0.5: short.append((d['src'], d['_need'], d['_have']))
        d.pop('_need'); d.pop('_have')
assert not short, ('실사 클립이 말보다 짧다', short)
assert len(USED) == len(ALL), ('안 쓴 줄', [ALL[i]['text'][:24] for i in range(len(ALL)) if i not in USED])
order = [l['i'] for s in scenes for l in s['lines'] if l['i'] is not None]; assert order == sorted(order), '줄 순서'
scenes[-1]['frames'] += TAIL
for s in scenes:
    for l in s['lines']: l.pop('i')

live = brk = 0; tot = sum(s['frames'] for s in scenes)
RUNS = []; run = 0; grp = []; mx = 0
for s in scenes:
    if s['kind'] in ('broll', 'pic'): live += s['frames']
    if s['kind'] in ('broll', 'ask', 'brand', 'pic'):
        brk += 1
        if run / FPS > 19.5: RUNS.append((round(run / FPS, 1), grp))
        run = 0; grp = []
    else: run += s['frames']; mx = max(mx, run); grp.append(s['data'].get('title'))
if run / FPS > 19.5: RUNS.append((round(run / FPS, 1), grp))
assert not RUNS, RUNS

SKIP = {'pre', 'seed', 'audio', 'src', 'license', 'kind', 'icon', 'c', 'c1', 'c2', 'from', 'x', 'side', 'dir', 'max', 'at', 'at2', 'lit', 'done', 'step', 'mode', 'chapter', 'rv', 'hot', 'pic', 'inset', 'zoom', 'cx', 'cy'}
def strings(x):
    if isinstance(x, dict):
        for k, v in x.items():
            if k in SKIP: continue
            yield from strings(v)
    elif isinstance(x, list):
        for v in x:
            if not isinstance(v, (int, float)): yield from strings(v)
    elif isinstance(x, str): yield x
SRCDOC = CALC + SCRIPT
bad = []; nnum = 0
for s in scenes:
    for st in list(strings(s['data'])) + [l['cap'] for l in s['lines'] if l['cap']]:
        for d in re.findall(r'\d[\d,.]*', st):
            d = d.rstrip('.,'); nnum += 1
            if d not in SRCDOC: bad.append((st[:40], d))
assert not bad, bad

p = {'fps': FPS, 'scenes': scenes, 'badge': ''}
json.dump(p, open(os.path.join(VID, 'detf1.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
json.dump([{'id': c, 'used': USEDBG[c], 'desc_line': CR[c]['desc_line']} for c in sorted(USEDBG)], open(os.path.join(EP, 'bg_used.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
print(f'D-ETF-1 de1.json: {tot} 프레임 = {tot / FPS:.1f}초 · 장면 {len(scenes)} · 줄 {len(ALL)} · 종류 {len(set(s["kind"] for s in scenes))}'
      f' · 실사·그림 {live / tot * 100:.1f}%({live / FPS:.0f}초, 클립 {len(USEDBG)}개) · 바뀜 장면 {brk}(분당 {brk / (tot / FPS / 60):.1f}) · 판 이어짐 최장 {mx / FPS:.1f}초 · numcheck {nnum}덩이 불일치 0')
