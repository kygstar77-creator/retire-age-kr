     "frames": 63,
     "cap": null
    },
    {
     "text": "그런데 가장 최근 열두 달은 2% 느는 데 그쳤어요.",
     "audio": "audio/d-etf-1/b47c33eeddf31d6d.wav",
     "frames": 107,
     "cap": "10년 10.8% · 최근 1년 2.0%(1.034→1.055달러)"
    }
   ],
   "frames": 170,
   "data": {
    "title": "SCHD 한 주당 배당, 매년 늘어난 비율",
