<!-- } SE-TEXT --><!-- SE-TEXT { --><p class="se-text-paragraph se-text-paragraph-align- " style="" id="SE-7eb5f79d-9b98-435e-a6e1-9892118ea48e"><span style="" class="se-fs- se-ff-   " id="SE-3bb4e98f-6b39-4cc8-9011-3a473ba014c9">| DIVO | $47.09 | $3.0050 | 6.38% |</span></p>
<!-- } SE-TEXT --><!-- SE-TEXT { --><p class="se-text-paragraph se-text-paragraph-align- " style="" id="SE-9325d4dc-46c9-429a-b145-8f3c255ab73b"><span style="" class="se-fs- se-ff-   " id="SE-ced7b72c-d16f-46ab-a4b6-406ccb0e6c8b">| O | $55.61 | $3.2460 | 5.84% |</span></p>
<!-- } SE-TEXT --><!-- SE-TEXT { --><p class="se-text-paragraph se-text-paragraph-align- " style="" id="SE-ea18733d-d1ce-4a9a-be47-2ef6bd25df18"><span style="" class="se-fs- se-ff-   " id="SE-1f3bd8e5-09a6-4ea1-9127-c495dacb02f5">| PFF | $29.85 | $1.6430 | 5.50% |</span></p>
<!-- } SE-TEXT --><!-- SE-TEXT { --><p class="se-text-paragraph se-text-paragraph-align- " style="" id="SE-9a750d9d-c578-4eef-869a-6a3ded1e3b13"><span style="" class="se-fs- se-ff-   " id="SE-2054565b-cb96-474c-b607-062cc200b175">| SPHD | $49.18 | $2.4680 | 5.02% |</span></p>
<!-- } SE-TEXT --><!-- SE-TEXT { --><p class="se-text-paragraph se-text-paragraph-align- " style="" id="SE-e8c20e5c-dc90-49c5-951e-20fd473a92ad"><span style="" class="se-fs- se-ff-   " id="SE-cee68bba-c7ca-4a06-b49d-e8a19df05f3e">​</span></p>
<!-- } SE-TEXT --><!-- SE-TEXT { --><p class="se-text-paragraph se-text-paragraph-align- " style="" id="SE-98d75263-5381-4f82-b4df-25b8a02f8e39"><span style="" class="se-fs- se-ff-   " id="SE-8f7e841d-fafc-4867-bf8a-6d429644a432">QQQI와 SPYI는 12개월 동안 13회 들어왔네요. 나머지 열 개는 12회였고요.</span></p>
<!-- } SE-TEXT -->
                            </div>
