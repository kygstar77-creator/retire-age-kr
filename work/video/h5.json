   }
  },
  {
   "kind": "broll",
   "lines": [
    {
     "text": "가장 낮았던 1년도 같은 식으로 잡으면, 2022년 하반기부터 2023년 상반기까지예요.",
     "audio": "audio/h-5/681744cbedf96a60.wav",
     "frames": 187,
     "cap": null
    }
   ],
   "frames": 187,
   "data": {
    "src": "bg/h4/stock/38259259.mp4",
