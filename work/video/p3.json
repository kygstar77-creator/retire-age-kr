     "frames": 111,
     "cap": null
    },
    {
     "text": "마지막 해엔 20%였고, 올해 8월분으로 모두 끝났습니다.",
     "audio": "audio/p-3/a91bb1026b2b3608.wav",
     "frames": 128,
     "cap": null
