    "inset": 0.8,
    "dark": true,
    "zoom": [
     1.0,
     1.04
    ],
    "cx": 50,
    "cy": 45
   }
  },
  {
   "kind": "pic",
   "lines": [
    {
     "text": "그래서 내년에 오른 연금은, 그다음 해 판정에 들어가요. 이 계산대로라면 연금이 오른 내년이 아니라, 그다음 해부터 고지서가 오는 거예요.",
     "audio": "audio/p-3/febf69fd9c92899e.wav",
     "frames": 251,
     "cap": null
    }
   ],
   "frames": 251,
   "data": {
    "pic": "bg/p3/board/p3_timeline.png",
