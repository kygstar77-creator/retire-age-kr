# D-ETF-1 화면 재료 — script.md(편집 서명) + voice.json(Chirp 3 HD Charon 1.1) + calc_out·facts → work/video/de1.json (Remotion 'DE1' = J1 부품 그대로)
#   py -3.12 work/research/longform/ep/D-ETF-1/de1props.py
# 10/26 PD(15:3x 회차): j1props.py 틀을 그대로 빌림 — 판(big·pair·rows·bars·list5) ↔ 꽉 찬 실사(broll, Pexels bg/detf) ↔ 장 카드(ask) ↔ 종이 그림(pic: 히트맵·점 그림 fig/).
# 가상 인물 없음(10/21) — '지금 생활비가 필요한 분'·'오래 모을 직장인' 조건으로만. 줄은 말 글자 앞부분으로 찾는다(대본이 바뀌면 assert).
# 숫자: props 안 숫자 글자는 전부 calc_out·facts·script.md에 있는 글자만 — 맨 아래 numcheck가 막는다.
import json, os, re, sys
sys.stdout.reconfigure(encoding='utf-8')
EP = os.path.dirname(os.path.abspath(__file__))
WORK = os.path.normpath(os.path.join(EP, '..', '..', '..', '..'))
VID = os.path.join(WORK, 'video')
FPS, TAIL = 30, 75
END_PAD = 23 * 30   # 맺는 말 뒤 숨 3초 + 최종 화면 자리 20초(answer/6388789)
CALC = ''.join(open(os.path.join(EP, f), encoding='utf-8').read() for f in ('calc_out.txt', 'facts.txt'))
SCRIPT = open(os.path.join(EP, 'script.md'), encoding='utf-8').read()
V = json.load(open(os.path.join(EP, 'voice.json'), encoding='utf-8'))
ALL = [l for s in V['sections'] for l in s['lines']]
assert len(ALL) == 105, len(ALL)
assert abs(V.get('speakingRate', 0) - 1.1) < 1e-9 and V['voice'] == 'ko-KR-Chirp3-HD-Charon'
USED = set()

CR = {c['id']: c for c in json.load(open(os.path.join(VID, 'public', 'bg', 'detf', 'stock', 'credits.json'), encoding='utf-8'))}
CR[5562942] = {'id': 5562942, 'author': 'Daniel Qura', 'sec': 40, 'file': '../../t1/5562942.mp4', 'desc_line': '영상 일부: Daniel Qura / Pexels (https://www.pexels.com/video/time-lapse-video-of-the-sky-5562942/)'}

def L(t, cap=None):
    hit = [i for i, l in enumerate(ALL) if l['text'].startswith(t)]; assert len(hit) == 1, (t, hit)
    i = hit[0]; assert i not in USED, ('두 번 씀', t); USED.add(i)
    l = ALL[i]; assert l.get('audio') and os.path.exists(os.path.join(VID, 'public', l['audio'])), t
    assert cap is None or len(cap) <= 60, ('cap 길다', len(cap), cap)
    return {'text': l['text'], 'audio': l['audio'], 'frames': l['frames'], 'cap': cap, 'i': i}

def S(kind, lines, rvl=None, **data):
    ls = [L(*t) if isinstance(t, tuple) else L(t) for t in lines]
    if rvl is not None: data['rv'] = sum(l['frames'] for l in ls[:rvl]) + 8
    return {'kind': kind, 'lines': ls, 'frames': sum(l['frames'] for l in ls), 'data': data}

SRC_Y = '야후 파이낸스 분배·가격(2026-10-16 마감) · 파이어맵 계산'
SRC_S = '운용사 보유 종목·섹터 표(2026-09-30~10-16) · 네이버 증권 · 파이어맵 합산'
SRC_T = '소득세법 §129 · 국민건강보험법 시행규칙 §44 · 파이어맵 계산'
A = 'accent'; K = 'ink'; B = 'fall'; R = 'rise'; G = 'g'
def big(title, v, s, lines, c=A, src=SRC_Y, **d): return S('big', lines, title=title, v=v, s=s, c=c, source=src, **d)
def pair(title, a, b, lines, src=SRC_Y, **d): return S('pair', lines, title=title, v1=a[0], s1=a[1], c1=a[2], v2=b[0], s2=b[1], c2=b[2], source=src, **d)
def rows(title, rs, lines, src=SRC_Y, **d): return S('rows', lines, title=title, rows=rs, source=src, **d)
def bars(title, bs, lines, mx, dir='h', src=SRC_Y, **d): return S('bars', lines, title=title, bars=bs, max=mx, dir=dir, source=src, **d)
def ask(n, q, frm, lines): return S('ask', lines, n=n, q=q, **({'from': frm} if frm else {}))
def list5(title, items, lines, src='파이어맵'): return S('list5', lines, title=title, items=items, source=src)
def pic(f, lines, z=(1.0, 1.05), cx=50, cy=45): return S('pic', lines, pic=f'bg/detf/fig/{f}.png', license='파이어맵 자체 제작(운용사·야후 자료)', baked=True, inset=0.80, dark=True, zoom=list(z), cx=cx, cy=cy)
USEDBG = {}
def broll(cid, lines, say, side='left'):
    c = CR[cid]; k = USEDBG.get(cid, 0); USEDBG[cid] = k + 1; have = (c.get('sec') or 0) - 0.5
    s = S('broll', lines, src='bg/detf/stock/' + c.get('file', f'{cid}.mp4') if cid != 5562942 else 'bg/t1/5562942.mp4', license=f"Pexels {cid} 무료({c['author']})", say=say, side=side)
    sec = s['frames'] / FPS; frm = 0 if k == 0 else int(min(max(0, have - sec), k * 6))
    s['data']['from_'] = frm * FPS; s['data']['_need'] = round(sec + frm, 1); s['data']['_have'] = have
    return s

