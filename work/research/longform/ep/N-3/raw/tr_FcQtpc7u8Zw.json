[[0.199, "범성공자와"], [1.24, ">> 김민중환서의"], [2.28, ">> 경보기님"], [3.84, "안녕하세"], [4.08, ">> 반갑습니다."], [4.759, ">> 네. 오늘은 또 새로운 콘텐츠예요."], [7.359, ">> 맞습니다."], [8.16, ">> 네."], [8.639, ">> 그동안은 경제를 좀 어느 정도 알고"], [11.08, "주식을 해본 분들을 위한 콘텐츠를 좀"], [13.519, "만들었다면 이번엔 진짜 사회 초년생"], [16.44, "경제 주식 다 처음인 분들을 위한"], [19.279, "공부도 같이 한번 해 보려고"], [20.56, "하거든요."], [21.199, ">> 네. 맞습니다. 그런 분들이 차분하게"], [23.56, "어 재테크를 해 나가는 것들이"], [25.24, "필요하기 때문에 경제단 첫 번째"], [27.679, "스터디 어떻게 도착할까요?"], [29.92, "어, 일단은 돈"], [31.96, ">> 맞아요. 돈이 들어오는 것부터 그래서"], [34.0, "월급"], [34.84, ">> 내 월급을 아는 것부터 우리는"], [36.48, "시작해야 됩니다."], [37.36, ">> 네."], [37.8, ">> 근데 제가 처음에 회사 딱 들어갔을"], [40.879, "때 급여을 이제 산정을 했단"], [42.879, "말이에요. 제 첫 월급이 아마 너무"], [45.96, "작았어요."], [46.44, ">> 얼마였어요?"], [47.16, ">> 연봉으로 2,400만 원."], [48.76, ">> 2,400만 원?"], [49.84, ">> 어, 연봉으로 하면 2,400만"], [50.96, "원이었어요."], [51.559, ">> 처음에 증권사에 들어가신 거죠?"], [52.96, ">> 아니요. 그냥 자문사"], [55.0, ">> 200만 원인데 200만 원이 안"], [56.239, "들어오는 거야."], [57.68, ">> 나한테."], [58.12, ">> 아. 아. 나누기 10을 해서"], [59.719, "200인데 실수령이 200이 아니라"], [62.359, "아 그러면 15% 빠지니까 180"], [64.0, "들어오겠죠?"], [64.479, ">> 나한테 사기친 줄 알았어. [웃음]"], [67.32, ">> 맞아요. 사실 많은 분들이 직장을"], [70.08, "알아보거나 월급을 알아볼 때 이게 세"], [72.52, "전인지 새훈인지 막 고민도 되는 분도"], [75.4, "많고 친구들과 이야기할 때도 나 얼마"], [78.119, "받아라고 이야기해야 하는지 사회"], [80.759, "토년상 때는 고민이 많을 것 같아요."], [82.799, ">> 그렇죠. 첫 월급 우리는 왜 이만큼만"], [85.2, "찍히는지 우리 한번 살펴보도록"], [86.72, "하겠습니다."], [87.2, ">> 좋습니다."], [87.84, ">> 네. 저는 아까 2천만 원,"], [88.92, "2,400만 원 얘기했지만 연봉"], [90.2, "3천만 원이라고 해 보자고요. 그럼"], [91.52, "월에 얼마 들어가야?"], [92.799, ">> 연봉이 3천이면 월에 한 300"], [95.399, ">> 250만 원 정도 들어가"], [97.28, ">> 12원 이게 실수령액이 평균적으로"], [99.799, "얼마 정도 들어오냐면요 한 210만"], [101.84, "원이 좀 안 되게 들어와요."], [103.04, ">> 3,000도 절대 적게 보는게 아닌데"], [105.479, "세금이 많이 깎이는군요."], [107.0, ">> 그렇죠. 그니까 원래 250만 원"], [108.6, "정도 들어올 거라고 봤었는데 한 달에"], [110.28, "210만 원 정도 들어온대요. 한"], [112.36, "40만 원 날아가잖아."], [113.56, ">> 아 40이면 한 달에 할 수 있는게"], [116.52, "진짜 꽤 많아요."], [117.439, ">> 그러니까요. 한 두 세 모으면 플스"], [119.6, "5도 살 수 있고"], [120.36, ">> 맞아요. 저는 3일년생 때 80만"], [122.88, "원인가 60만 원만 썼던 거 같아요."], [125.56, ">> 한 달에."], [126.039, ">> 네. 한 달에. 나머지 다 모았는데도"], [127.759, "모 돈이 없었거든요. 그러니까"], [129.479, "40이라는 돈이 진짜 큰 거예요."], [131.28, ">> 어, 크죠. 그 이게 대체 어디로 간"], [133.0, "거냐? 네."], [133.959, ">> 이게 우리는 일단 이걸 알아야 돼요."], [135.4, "원천징수. 원천 징수, 원천 차단"], [138.48, "이런 거랑 비슷한 거예요."], [139.4, ">> 네. 원천적으로 뭔가 뺏어 간다라는"], [141.68, "건데"], [142.56, ">> 회사에서 저한테 이제 월급을 주죠."], [144.8, "그럼 월급을 줄 때 너 이만큼의"], [147.16, "세금은 내야 될 것 같아라고 미리"], [148.72, "떼놓니다."], [149.519, ">> 오."], [150.12, ">> 네. 미리 떼놓고 그거 이외에 돈을"], [152.879, "줘요. 그게 이제 원천 징수가 돼서"], [155.319, "세금 떼고 들어오는 거다. 이걸"], [156.68, "뭐라고 하죠? 소득세 떼고 들어오는"], [157.92, "거."], [158.04, ">> 소득세. 네."], [159.2, ">> 그래서 우리는 월급을 뭐라고도"], [160.4, "표현하냐면"], [162.239, ">> 뭐라고 하죠?"], [163.12, ">> 어 무슨 원렛이라고 해? 무슨"], [164.48, "지갑이라고 얘기해? 아, 유리 원렛."], [166.84, ">> 맞아요. 글라스 원렛. 네. 유리"], [169.239, "지갑이라고 하죠. 왜? 네."], [170.84, ">> 내가 버는게 투명하게 다 드러난다고."], [172.84, ">> 네. 그렇죠."], [173.4, ">> 그렇죠. 보통 이제 우리 상정 가면"], [175.28, "현금으로 하면 좀 할인해 주나. 왜"], [176.48, "이렇게 되는게 왜 그런 줄 알아요?"], [178.2, ">> 어, 이렇게 자영업할 때는 내가"], [181.4, "신고를 또 하잖아요. 그러다 보니까"], [183.68, "직장인의 그 유리 지값과 또 차이가"], [185.92, "있는 거 같아요."], [186.56, ">> 그죠? 카드 결제하면 어쩔 수 없이"], [188.28, "다 신고되는데 현금으로 결제하면 약간"], [190.879, "이제 안 할 수도 있잖아요. 근데"], [193.28, "월급적인 그게 불가능하죠. 유리 지갑"], [195.239, "다 투명하게 세금 다 내야 돼."], [197.0, ">> 근데 어쨌든요 유리 지갑에서 우리는"], [199.319, "원천 징수라는 걸 한다. 근데 원천"], [201.799, "징수를 한 다음에 네가 낸 세금을"], [204.12, "봤더니 너 좀 부족한 거 같은데"], [206.599, "아니면 어 너 좀 더낸 거 같은데라고"], [208.68, "해서 우리가 뭐 13월의 월급이라고"], [211.56, "하는 거죠."], [212.08, ">> 어 연말 정산."], [213.239, ">> 연말 정산. 연말 정산에 우리가 덜"], [215.439, "냈으면 돈을 더"], [216.84, ">> 내야 되고네."], [217.879, ">> 울면서"], [218.959, ">> 돈을 더 내든다고요? 말고 어떨 때는"], [221.159, "받기도 하고"], [221.76, ">> 아 돈을 더 내시는 스타일이어서 받는"], [223.64, "스타일이세요? 저는 지금 프리랜서기"], [226.879, "때문에 네. 딱히 뭐 그런게 아 이게"], [230.92, "또 직장인일 때는 연말 정상 이후에"], [233.079, "받는 금액이 좀 쏠쏠하더라고요."], [234.84, ">> 아, 그렇죠. 네